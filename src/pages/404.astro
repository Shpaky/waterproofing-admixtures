---
import Base from '@/layouts/Base.astro';
import { localePath, t } from '@/i18n';

const dict = t('en');
---

<Base locale="en" title={dict.notFound.title} noindex path="404">
  <main id="main" class="mx-auto flex max-w-content flex-1 flex-col items-start gap-4 px-4 py-24">
    <h1 class="text-4xl font-bold text-brand-900">404</h1>
    <p class="text-lg text-ink-muted">{dict.notFound.title}</p>
    <a href={localePath('en')} class="font-semibold text-brand-700 underline"
      >{dict.notFound.back}</a
    >
  </main>
</Base>
