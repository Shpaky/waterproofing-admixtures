---
import Button from '@/components/ui/Button.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { contacts } from '@/data/contacts';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const c = dict.contacts;

const rows: { icon: IconName; label: string; value: string; href?: string; external?: boolean }[] =
  [
    { icon: 'phone', label: c.phone, value: contacts.phoneDisplay, href: contacts.phoneHref },
    { icon: 'whatsapp', label: c.whatsapp, value: contacts.phoneDisplay, href: contacts.whatsapp },
    {
      icon: 'telegram',
      label: c.telegram,
      value: contacts.telegram.replace('https://t.me/', '@'),
      href: contacts.telegram,
    },
    { icon: 'mail', label: c.email, value: contacts.email, href: `mailto:${contacts.email}` },
    { icon: 'pin', label: c.address, value: contacts.address[locale] },
    { icon: 'globe', label: c.hours, value: contacts.hours[locale] },
  ];

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: contacts.company,
  legalName: contacts.legalName,
  description: `${dict.company.role}. ${dict.company.pavilion}.`,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  telephone: contacts.phoneHref.replace('tel:', ''),
  email: contacts.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contacts.address.en,
    addressLocality: 'Navi Mumbai',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: contacts.phoneHref.replace('tel:', ''),
    contactType: 'sales',
    availableLanguage: ['en', 'ru', 'hi'],
    hoursAvailable: contacts.openingHours,
  },
  sameAs: [contacts.whatsapp, contacts.telegram],
});
---

<Section id="contacts" title={c.title} eyebrow={c.eyebrow} lead={c.lead} tone="alt">
  <div class="grid gap-8 lg:grid-cols-5">
    <div class="rounded-lg bg-brand-900 p-6 text-ink-inverse md:p-8 lg:col-span-2">
      <p class="eyebrow text-brand-100">{c.quick}</p>
      <p class="mt-3 text-h3">{contacts.phoneDisplay}</p>
      <p class="mt-1 text-sm text-brand-100/80">{contacts.hours[locale]}</p>
      <div class="mt-6 flex flex-col gap-3">
        <Button href={contacts.whatsapp} icon="whatsapp" size="lg" class="w-full">
          {dict.cta.whatsapp}
        </Button>
        <Button href={contacts.phoneHref} icon="phone" variant="inverse" size="lg" class="w-full">
          {dict.cta.call}
        </Button>
        <Button href={contacts.telegram} icon="telegram" variant="inverse" size="lg" class="w-full">
          {dict.cta.telegram}
        </Button>
      </div>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-3" role="list">
      {
        rows.map((row) => (
          <li class="flex gap-4 rounded-lg border border-line bg-surface p-5">
            <span class="grid size-11 shrink-0 place-items-center rounded-md bg-brand-50 text-brand-500">
              <Icon name={row.icon} class="size-6" />
            </span>
            <div class="min-w-0">
              <p class="text-sm text-ink-muted">{row.label}</p>
              <p class="font-semibold break-words">
                {row.href ? (
                  <a
                    href={row.href}
                    rel={/^https?:/.test(row.href) ? 'noopener' : undefined}
                    class="text-brand-700 hover:underline"
                  >
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <script is:inline type="application/ld+json" set:html={jsonLd} />
</Section>
