---
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { contactsUrl } from '@/data/contacts';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale).audience;
---

<Section id="audience" title={dict.title} eyebrow={dict.eyebrow} lead={dict.lead}>
  <ul class="grid gap-6 lg:grid-cols-3" role="list">
    {
      dict.items.map((item) => (
        <Card tag="li" class="flex flex-col gap-4">
          <span class="grid size-12 place-items-center rounded-md bg-brand-50 text-brand-500">
            <Icon name={item.icon as IconName} class="size-7" />
          </span>
          <h3 class="text-h3">{item.title}</h3>
          <p class="text-ink-muted">{item.text}</p>
          <ul class="flex flex-col gap-2 text-sm" role="list">
            {item.points.map((pt) => (
              <li class="flex gap-2">
                <Icon name="check" class="mt-0.5 size-4 shrink-0 text-success" />
                <span>{pt}</span>
              </li>
            ))}
          </ul>
          <Button
            href={contactsUrl(locale)}
            icon="arrow-right"
            variant="secondary"
            class="mt-auto self-start"
          >
            {item.cta}
          </Button>
        </Card>
      ))
    }
  </ul>
</Section>
