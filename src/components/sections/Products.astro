---
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { contacts } from '@/data/contacts';
import { products } from '@/data/products';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const p = dict.products;
const needsVerify = products.some((x) => x.specs.some((s) => s.verify));
---

<Section id="products" title={p.title} eyebrow={p.eyebrow} lead={p.lead} tone="alt">
  <ul class="grid gap-6 lg:grid-cols-2" role="list">
    {
      products.map((product) => (
        <Card tag="li" class="flex flex-col gap-5">
          <div class="flex items-center gap-4">
            <span class="grid size-14 shrink-0 place-items-center rounded-md bg-brand-50 text-brand-500">
              <Icon name={product.icon} class="size-8" />
            </span>
            <div>
              <h3 class="text-h3">{product.name}</h3>
              <p class="text-sm text-ink-muted">{product.kind[locale]}</p>
            </div>
          </div>
          <p class="text-lead text-ink">{product.tagline[locale]}</p>
          <p class="text-ink-muted">{product.description[locale]}</p>
          <ul class="flex flex-col gap-2" role="list">
            {product.bullets.map((b) => (
              <li class="flex gap-2">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-success" />
                <span>{b[locale]}</span>
              </li>
            ))}
          </ul>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-2 rounded-md bg-surface-alt p-4 text-sm">
            <dt class="col-span-2 mb-1 eyebrow">{p.specsTitle}</dt>
            {product.specs.map((s) => (
              <>
                <dt class="text-ink-muted">{s.label[locale]}</dt>
                <dd class="font-semibold">
                  {s.value[locale]}
                  {s.verify && <span aria-hidden="true">*</span>}
                </dd>
              </>
            ))}
          </dl>
          <div class="mt-auto flex flex-wrap gap-3 pt-2">
            <Button href={contacts.whatsapp} icon="whatsapp">
              {dict.cta.whatsapp}
            </Button>
            <Button href={contacts.whatsapp} icon="document" variant="secondary">
              {p.askTds}
            </Button>
          </div>
        </Card>
      ))
    }
  </ul>
  {needsVerify && <p class="mt-4 text-sm text-ink-muted">* {p.verify}</p>}

  <div
    class="mt-10 flex flex-col gap-4 rounded-lg bg-brand-900 p-6 text-ink-inverse md:flex-row md:items-center md:gap-8 md:p-8"
  >
    <span
      class="grid size-14 shrink-0 place-items-center rounded-md bg-brand-500/40 text-brand-100"
    >
      <Icon name="shield" class="size-8" />
    </span>
    <div>
      <h3 class="text-h3">{p.systemTitle}</h3>
      <p class="mt-1 text-brand-100">{p.systemText}</p>
    </div>
  </div>
</Section>
