---
import Card from '@/components/ui/Card.astro';
import Icon, { type IconName } from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale).how;
---

<Section id="how-it-works" title={dict.title} eyebrow={dict.eyebrow} lead={dict.lead}>
  <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
    <div>
      <h3 class="mb-6 text-h3 text-accent">{dict.problemsTitle}</h3>
      <ul class="flex flex-col gap-4" role="list">
        {
          dict.problems.map((p) => (
            <Card tag="li" tone="alt" class="flex gap-4 p-5 md:p-6">
              <span class="grid size-11 shrink-0 place-items-center rounded-md bg-accent-soft text-accent">
                <Icon name={p.icon as IconName} class="size-6" />
              </span>
              <div>
                <p class="font-bold">{p.title}</p>
                <p class="mt-1 text-sm text-ink-muted">{p.text}</p>
              </div>
            </Card>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="mb-6 text-h3 text-brand-700">{dict.stepsTitle}</h3>
      <ol class="relative flex flex-col gap-6 border-l-2 border-brand-100 pl-8">
        {
          dict.steps.map((s, i) => (
            <li class="relative">
              <span
                class="absolute top-0 -left-8 grid size-8 -translate-x-1/2 place-items-center rounded-full bg-brand-500 text-sm font-bold text-ink-inverse"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <p class="font-bold">{s.title}</p>
              <p class="mt-1 text-sm text-ink-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 rounded-md border-l-4 border-brand-500 bg-brand-50 p-5 text-brand-950">
        {dict.result}
      </p>
    </div>
  </div>
</Section>
