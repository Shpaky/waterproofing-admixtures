---
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { contacts } from '@/data/contacts';
import { documents } from '@/data/documents';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale).documents;
const base = import.meta.env.BASE_URL;
---

<Section id="documents" title={dict.title} eyebrow={dict.eyebrow} lead={dict.lead} tone="alt">
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      documents.map((doc) => {
        const title = doc.title[locale];
        const available = Boolean(doc.href);
        return (
          <li class="flex items-start gap-4 rounded-lg border border-line bg-surface p-5">
            <span
              class:list={[
                'grid size-11 shrink-0 place-items-center rounded-md',
                available ? 'bg-brand-50 text-brand-500' : 'bg-surface-alt text-ink-muted',
              ]}
            >
              <Icon name="document" class="size-6" />
            </span>
            <div class="min-w-0 flex-1">
              <h3 class="font-bold">{title}</h3>
              <p class="mt-0.5 text-sm text-ink-muted">
                {doc.kind[locale]}
                {available && doc.size ? ` · ${doc.size}` : ` · ${dict.pending}`}
              </p>
              {available ? (
                <a
                  href={`${base}${doc.href}`}
                  class="mt-3 inline-flex items-center gap-1 font-semibold text-brand-700 hover:underline"
                  download
                >
                  {dict.download}
                  <span class="sr-only">: {title}</span>
                  <Icon name="arrow-right" class="size-4" />
                </a>
              ) : (
                <a
                  href={contacts.whatsapp}
                  rel="noopener"
                  class="mt-3 inline-flex items-center gap-1 font-semibold text-brand-700 hover:underline"
                >
                  {dict.request}
                  <span class="sr-only">: {title}</span>
                  <Icon name="whatsapp" class="size-4" />
                </a>
              )}
            </div>
          </li>
        );
      })
    }
  </ul>
</Section>
