---
/** Inline SVG icons on currentColor. Decorative by default (aria-hidden). */
export type IconName =
  | 'phone'
  | 'whatsapp'
  | 'telegram'
  | 'mail'
  | 'pin'
  | 'check'
  | 'arrow-right'
  | 'drop'
  | 'shield'
  | 'crystal'
  | 'truck'
  | 'document'
  | 'menu'
  | 'close'
  | 'globe'
  | 'chevron-down';

interface Props {
  name: IconName;
  class?: string;
  label?: string;
}
const { name, class: className = 'size-6', label } = Astro.props;

const paths: Record<IconName, string> = {
  phone:
    'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  whatsapp:
    'M20 11.5A8 8 0 0 1 8.3 18.6L4 20l1.4-4.2A8 8 0 1 1 20 11.5zM9 8.5c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4l.7 1.7c.1.2 0 .4-.1.5l-.5.6c-.1.2-.2.3 0 .5a6 6 0 0 0 2.9 2.6c.2.1.3 0 .5-.1l.7-.8c.2-.2.3-.2.5-.1l1.6.8c.2.1.4.2.4.4a2 2 0 0 1-.5 1.4c-.4.4-1 .7-1.6.7-1 0-2.3-.5-3.6-1.4A9 9 0 0 1 8.4 11c-.4-1-.2-1.9.6-2.5z',
  telegram: 'M21 4 3 11l5 2 2 6 3-3 4 3 4-15zM8 13l9-6-7 7.5',
  mail: 'M3 6h18v12H3zM3 7l9 6 9-6',
  pin: 'M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12zM12 12a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  check: 'M5 12.5 10 17l9-10',
  'arrow-right': 'M5 12h14M13 6l6 6-6 6',
  drop: 'M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z',
  shield: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3zM9 12l2 2 4-4',
  crystal: 'M12 2l7 7-7 13-7-13 7-7zM5 9h14M12 2l-3 7 3 13 3-13-3-7',
  truck:
    'M3 6h11v10H3zM14 10h4l3 3v3h-7zM7 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM17 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z',
  document: 'M6 2h8l5 5v15H6zM14 2v5h5M9 13h6M9 17h6',
  menu: 'M4 7h16M4 12h16M4 17h16',
  close: 'M6 6l12 12M18 6 6 18',
  globe: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18',
  'chevron-down': 'M6 9l6 6 6-6',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <path d={paths[name]}></path>
</svg>
