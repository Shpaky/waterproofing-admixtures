---
/**
 * Landing section: anchor id, optional eyebrow, title and lead.
 * `tone` switches background; heading always renders for a11y outline.
 */
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  lead?: string;
  tone?: 'default' | 'alt' | 'dark';
  align?: 'left' | 'center';
  class?: string;
}
const {
  id,
  title,
  eyebrow,
  lead,
  tone = 'default',
  align = 'left',
  class: className = '',
} = Astro.props;
const tones = {
  default: 'bg-surface',
  alt: 'bg-surface-alt',
  dark: 'bg-surface-dark text-ink-inverse',
};
const headingId = `${id}-title`;
---

<section id={id} aria-labelledby={headingId} class:list={['py-section', tones[tone], className]}>
  <div class="mx-auto w-full max-w-content px-4 sm:px-6 lg:px-8">
    <header class:list={['mb-10 max-w-3xl md:mb-14', align === 'center' && 'mx-auto text-center']}>
      {
        eyebrow && (
          <p class:list={['eyebrow mb-3', tone === 'dark' && 'text-brand-100']}>{eyebrow}</p>
        )
      }
      <h2 id={headingId} class="text-h2">{title}</h2>
      {
        lead && (
          <p class:list={['mt-4 text-lead', tone === 'dark' ? 'text-brand-100' : 'text-ink-muted']}>
            {lead}
          </p>
        )
      }
    </header>
    <slot />
  </div>
</section>
