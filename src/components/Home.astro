---
import Base from '@/layouts/Base.astro';
import { contacts } from '@/data/contacts';
import { localeNames, localePath, locales, t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<Base locale={locale}>
  <header class="border-b border-line">
    <nav
      class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3"
      aria-label={dict.nav.lang}
    >
      <a href={localePath(locale)} class="font-bold text-brand-700">D5</a>
      <ul class="flex gap-3 text-sm">
        {
          locales.map((l) => (
            <li>
              <a
                href={localePath(l)}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'page' : undefined}
                class:list={[
                  'rounded-md px-2 py-1 hover:underline',
                  l === locale && 'bg-brand-50 text-brand-700',
                ]}
              >
                {localeNames[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main id="main" class="mx-auto flex w-full max-w-content flex-1 flex-col gap-6 px-4 py-16">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-brand-900 md:text-5xl">
      {dict.hero.title}
    </h1>
    <p class="max-w-2xl text-lg text-ink-muted">{dict.hero.lead}</p>
    <div class="flex flex-wrap gap-3">
      <a
        href={contacts.phoneHref}
        class="rounded-md bg-brand-500 px-5 py-3 font-semibold text-surface hover:bg-brand-700"
        >{dict.cta.call}</a
      >
      <a
        href={contacts.whatsapp}
        rel="noopener"
        class="rounded-md border border-brand-500 px-5 py-3 font-semibold text-brand-700 hover:bg-brand-50"
        >{dict.cta.whatsapp}</a
      >
    </div>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto max-w-content px-4 py-6 text-sm text-ink-muted">
      {contacts.company} · {dict.footer.madeIn} · {dict.footer.rights}
    </div>
  </footer>
</Base>
