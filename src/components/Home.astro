---
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import Container from '@/components/ui/Container.astro';
import Icon from '@/components/ui/Icon.astro';
import Section from '@/components/ui/Section.astro';
import { contacts } from '@/data/contacts';
import { products } from '@/data/products';
import { localeNames, localePath, locales, t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<Base locale={locale}>
  <header class="border-b border-line">
    <Container tag="nav" class="flex items-center justify-between gap-4 py-3">
      <a href={localePath(locale)} class="text-lg font-extrabold text-brand-700">D5</a>
      <ul class="flex gap-1 text-sm" aria-label={dict.nav.lang}>
        {
          locales.map((l) => (
            <li>
              <a
                href={localePath(l)}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'page' : undefined}
                class:list={[
                  'rounded-sm px-2 py-1 hover:underline',
                  l === locale && 'bg-brand-50 font-semibold text-brand-700',
                ]}
              >
                {localeNames[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </header>

  <main id="main" class="flex-1">
    <Container class="flex flex-col gap-6 py-section-sm md:py-section">
      <p class="eyebrow">{dict.footer.madeIn}</p>
      <h1 class="max-w-4xl text-display text-brand-900">{dict.hero.title}</h1>
      <p class="max-w-2xl text-lead text-ink-muted">{dict.hero.lead}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={contacts.phoneHref} icon="phone" size="lg">{dict.cta.call}</Button>
        <Button href={contacts.whatsapp} icon="whatsapp" variant="secondary" size="lg">
          {dict.cta.whatsapp}
        </Button>
      </div>
    </Container>

    <Section id="products" title={dict.products.title} eyebrow={dict.products.eyebrow} tone="alt">
      <ul class="grid gap-6 md:grid-cols-2" role="list">
        {
          products.map((p) => (
            <Card tag="li" class="flex flex-col gap-4">
              <div class="flex items-center gap-3">
                <span class="grid size-12 place-items-center rounded-md bg-brand-50 text-brand-500">
                  <Icon name={p.icon} class="size-7" />
                </span>
                <div>
                  <h3 class="text-h3">{p.name}</h3>
                  <p class="text-sm text-ink-muted">{p.kind[locale]}</p>
                </div>
              </div>
              <p class="text-ink">{p.tagline[locale]}</p>
              <ul class="flex flex-col gap-2 text-sm">
                {p.bullets.map((b) => (
                  <li class="flex gap-2">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-success" />
                    <span>{b[locale]}</span>
                  </li>
                ))}
              </ul>
              <Button
                href={contacts.whatsapp}
                variant="ghost"
                icon="arrow-right"
                class="self-start"
              >
                {dict.cta.whatsapp}
              </Button>
            </Card>
          ))
        }
      </ul>
    </Section>
  </main>

  <footer class="border-t border-line">
    <Container class="py-6 text-sm text-ink-muted">
      {contacts.company} · {dict.footer.madeIn} · {dict.footer.rights}
    </Container>
  </footer>
</Base>
