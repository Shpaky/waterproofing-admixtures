---
import Base from '@/layouts/Base.astro';
import Header from '@/components/sections/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Products from '@/components/sections/Products.astro';
import Benefits from '@/components/sections/Benefits.astro';
import Applications from '@/components/sections/Applications.astro';
import Audience from '@/components/sections/Audience.astro';
import Container from '@/components/ui/Container.astro';
import { contacts } from '@/data/contacts';
import { t, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
---

<Base locale={locale}>
  <Header locale={locale} />

  <main id="main" class="flex-1">
    <Hero locale={locale} />
    <HowItWorks locale={locale} />

    <Products locale={locale} />
    <Benefits locale={locale} />
    <Applications locale={locale} />
    <Audience locale={locale} />
  </main>

  <footer class="border-t border-line">
    <Container class="py-6 text-sm text-ink-muted">
      {contacts.company} · {dict.footer.madeIn} · {dict.footer.rights}
    </Container>
  </footer>
</Base>
